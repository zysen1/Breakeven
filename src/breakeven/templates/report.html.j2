<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Breakeven — go-live qualification</title>
<style>
  :root {
    --paper: #f3efe4;
    --ink: #1c1915;
    --muted: #5e574c;
    --line: #ddd4c4;
    --card: #fffdf8;
    --go: #0e6b4a;
    --go-bg: #e5f4ec;
    --stop: #9d1c2b;
    --stop-bg: #fdecee;
    --warn: #8a5a00;
    --warn-bg: #fbf3df;
    --accent: #1f4d3a;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font: 15px/1.5 "Segoe UI", system-ui, sans-serif;
  }
  header, main { width: min(1100px, calc(100% - 32px)); margin: 0 auto; }
  header { display: flex; justify-content: space-between; gap: 24px; padding: 32px 0 8px; align-items: flex-start; }
  .kicker { letter-spacing: 0.14em; text-transform: uppercase; font-size: 12px; color: var(--muted); margin: 0 0 8px; }
  h1 { font-family: Georgia, "Iowan Old Style", Palatino, serif; font-weight: 500; font-size: 40px; line-height: 1.05; margin: 0 0 8px; }
  h2 { font-family: Georgia, Palatino, serif; font-weight: 500; font-size: 22px; margin: 0 0 8px; }
  .lede { max-width: 62ch; color: var(--muted); margin: 0; }
  .stamp {
    border: 3px solid var(--go);
    color: var(--go);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 10px 14px;
    transform: rotate(-8deg);
    border-radius: 6px;
    min-width: 148px;
    text-align: center;
    background: transparent;
  }
  .stamp.stop { border-color: var(--stop); color: var(--stop); }
  .stamp.warn { border-color: var(--warn); color: var(--warn); }
  .bar { display: flex; gap: 16px; align-items: center; padding: 8px 0 18px; flex-wrap: wrap; }
  .bar label { font-size: 13px; color: var(--muted); }
  input[type="range"] { width: min(420px, 70vw); accent-color: var(--accent); }
  .note { color: var(--muted); font-size: 13px; margin: 0; max-width: 78ch; }
  .lang { margin-left: auto; }
  button {
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 10px;
    cursor: pointer;
    color: var(--ink);
  }
  button[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 12px 14px;
    cursor: pointer;
    min-height: 168px;
  }
  .card.active { outline: 2px solid var(--accent); }
  .card h3 { margin: 0 0 2px; font-size: 16px; }
  .card .acc { color: var(--muted); font-size: 13px; margin: 0 0 8px; }
  .pill { display: inline-block; font-size: 11px; letter-spacing: 0.08em; font-weight: 700; padding: 2px 6px; border-radius: 999px; }
  .pill.go { background: var(--go-bg); color: var(--go); }
  .pill.stop { background: var(--stop-bg); color: var(--stop); }
  .pill.warn { background: var(--warn-bg); color: var(--warn); }
  .metric { font-variant-numeric: tabular-nums; font-size: 13px; margin: 2px 0; }
  .trap {
    margin: 16px 0;
    background: var(--stop-bg);
    border: 1px solid #e7c4c8;
    border-radius: 12px;
    padding: 14px 16px;
  }
  .trap strong { color: var(--stop); }
  .layout { display: grid; grid-template-columns: 1.4fr 0.8fr; gap: 12px; }
  .panel { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; margin-bottom: 12px; }
  svg { width: 100%; height: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; font-variant-numeric: tabular-nums; }
  th, td { text-align: left; padding: 4px 6px; border-bottom: 1px solid var(--line); }
  th { color: var(--muted); font-weight: 600; }
  footer { color: var(--muted); font-size: 12px; padding: 8px 0 40px; }
  .axis { fill: var(--muted); font-size: 11px; }
  @media (max-width: 900px) {
    .cards, .layout { grid-template-columns: 1fr; }
    header { flex-direction: column; }
  }
</style>
</head>
<body>
<header>
  <div>
    <p class="kicker" id="kicker"></p>
    <h1 id="title"></h1>
    <p class="lede" id="lede"></p>
  </div>
  <div class="stamp" id="stamp"></div>
</header>
<main>
  <div class="bar">
    <label id="slider-label" for="target"></label>
    <input id="target" type="range" min="0.80" max="0.99" step="0.01">
    <output id="target-out"></output>
    <div class="lang">
      <button type="button" id="en" aria-pressed="true">EN</button>
      <button type="button" id="zh" aria-pressed="false">中文</button>
    </div>
  </div>
  <p class="note" id="slider-note"></p>
  <section class="cards" id="cards"></section>
  <section class="trap" id="trap"></section>
  <section class="layout">
    <div class="panel" id="chart-panel"></div>
    <div class="panel" id="tornado-panel"></div>
  </section>
  <section class="panel" id="detail"></section>
  <section class="panel" id="assumptions"></section>
  <footer id="foot"></footer>
</main>
<script id="payload" type="application/json">{{ payload_json }}</script>
<script id="vega" type="application/vnd.vegalite+json">{{ vega_json }}</script>
<script>
const PAYLOAD = JSON.parse(document.getElementById("payload").textContent);
const I18N = {
  en: {
    kicker: "Acme insurance claims · synthetic shadow study",
    title: "Prove it's worth going live.",
    lede: "Policies are chosen on the calibration split. The lower bound and the hours beside a verdict are the holdout check of that frozen policy. Cost inputs are Acme's illustration, not an industry average.",
    slider: "Reliability target",
    sliderNote: "Moving the slider re-ranks policies with calibration evidence only. The holdout numbers are the check for the policy that ranking picks. Choosing a target because its holdout happened to pass is not a new qualification.",
    trapTitle: "The 90% automation trap",
    chart: "Fully loaded dollars",
    tornado: "What the savings swing with (±30%)",
    assumptions: "Assumptions",
    focus: "Operating point",
    categories: "Calibration-set accuracy by category (diagnostic, not a searched feature)",
    assertions: "State violations that still ship",
    human: "All-human",
    agent: "Agent system",
    noPolicy: "No calibration policy clears this target.",
    foot: "Offline file. The Vega-Lite spec is embedded for the pre-registered curve and is not fetched. No model API was called.",
    a1: "Go-live needs both a holdout lower bound at or above the target and fully loaded savings whose resampled 5th percentile is still positive.",
    a2: "Human reviewers are assumed perfect at the headline target. The a_h row is how weak that assumption can be before the conditional bound misses.",
    a3: "Two-key categories are a customer menu (health, liability, amount cutoffs), not a search over the holdout.",
    a4: "Cases are treated as independent. Clustered books need a wider bound than this page reports."
  },
  zh: {
    kicker: "Acme 保险理赔 · 合成影子回放",
    title: "上线前先算清账。",
    lede: "策略只在调参集上选定。结论旁边的下界和工时，是这条已冻结策略在留出集上的核对。成本是 Acme 的示例参数，不是行业平均。",
    slider: "可靠性目标",
    sliderNote: "拖动滑块只按调参集的证据重新排序。留出集数字是该排序所选策略的核对。因为某档目标的留出集碰巧通过就改目标，并不是一次新的资格认定。",
    trapTitle: "自动化九成的陷阱",
    chart: "全成本金额",
    tornado: "节省额对参数的敏感度（±30%）",
    assumptions: "前提",
    focus: "运行点",
    categories: "调参集上各类别准确率（诊断，不拿去搜索策略）",
    assertions: "仍然会发出去的状态违规",
    human: "全人工",
    agent: "代理系统",
    noPolicy: "调参集上没有策略能达到这个目标。",
    foot: "离线文件。预注册曲线的 Vega-Lite 规范嵌在页面里，不会去下载。没有调用模型接口。",
    a1: "上线要同时满足：留出集下界不低于目标，并且全成本节省额的重抽样第 5 百分位仍为正。",
    a2: "标题上的目标把复核人员当成不会出错。a_h 那一行表示这个假定可以差到什么程度，条件界就不再达标。",
    a3: "双人复核的类别是客户菜单（健康险、责任险、金额阈值），不是在留出集上搜出来的。",
    a4: "案例按独立处理。如果按客户或机构成簇，区间应当更宽，这一页没有做簇水平的界。"
  }
};
const STATUS = {
  go: {en: "Go", zh: "可上线", cls: "go"},
  reliability_only: {en: "Reliability only", zh: "只够可靠", cls: "warn"},
  cost_uncertain: {en: "Cost uncertain", zh: "成本不稳", cls: "warn"},
  holdout_miss: {en: "Holdout miss", zh: "留出集未过", cls: "stop"},
  no_eligible_policy: {en: "No policy", zh: "没有策略", cls: "stop"}
};
let lang = "en";
let focus = "careful";
const slider = document.getElementById("target");
slider.value = String(PAYLOAD.study.target.reliability);

function t(key) { return I18N[lang][key]; }
function pct(x) { return (x * 100).toFixed(1) + "%"; }
function hrs(x) { return (x == null ? "—" : x.toFixed(1) + " h"); }
function money(x) { return (x == null ? "—" : "$" + Math.round(x).toLocaleString("en-US")); }

function pick(agent, target) {
  const eligible = agent.policies.filter(p => p.dev_lcb >= target - 1e-12);
  if (!eligible.length) return null;
  eligible.sort((a, b) => (a.selection_dollars - b.selection_dollars) || (b.dev_lcb - a.dev_lcb) || a.id.localeCompare(b.id));
  return eligible[0];
}
function statusOf(policy, target) {
  if (!policy) return "no_eligible_policy";
  const h = policy.holdout;
  if (!(h.lcb >= target)) return "holdout_miss";
  if (!(h.savings_dollars > 0)) return "reliability_only";
  if (h.bootstrap && !(h.bootstrap.p05 > 0)) return "cost_uncertain";
  return "go";
}

function render() {
  const target = Number(slider.value);
  document.getElementById("target-out").textContent = pct(target);
  document.getElementById("kicker").textContent = t("kicker");
  document.getElementById("title").textContent = t("title");
  document.getElementById("lede").textContent = t("lede");
  document.getElementById("slider-label").textContent = t("slider");
  document.getElementById("slider-note").textContent = t("sliderNote");
  document.getElementById("en").setAttribute("aria-pressed", String(lang === "en"));
  document.getElementById("zh").setAttribute("aria-pressed", String(lang === "zh"));

  const cards = document.getElementById("cards");
  cards.innerHTML = "";
  let focusedAgent = PAYLOAD.agents[0];
  let focusedPolicy = null;
  for (const agent of PAYLOAD.agents) {
    const policy = pick(agent, target);
    const status = statusOf(policy, target);
    if (agent.id === focus) { focusedAgent = agent; focusedPolicy = policy; }
    const div = document.createElement("article");
    div.className = "card" + (agent.id === focus ? " active" : "");
    div.tabIndex = 0;
    const meta = STATUS[status];
    const hold = policy ? policy.holdout : null;
    div.innerHTML = `
      <h3>${agent.name}</h3>
      <p class="acc">${pct(agent.accuracy)} · ${agent.summary}</p>
      <span class="pill ${meta.cls}">${meta[lang]}</span>
      <p class="metric">${policy ? policy.label : t("noPolicy")}</p>
      <p class="metric">LCB ${hold ? pct(hold.lcb) : "—"} · ${hold ? pct(hold.human_touch_rate) : "—"}</p>
      <p class="metric">${hold ? hrs(hold.hours) : "—"} / ${hold ? hrs(hold.baseline_hours) : "—"}</p>`;
    div.addEventListener("click", () => { focus = agent.id; render(); });
    cards.appendChild(div);
  }
  const stamp = document.getElementById("stamp");
  const st = statusOf(focusedPolicy, target);
  stamp.textContent = STATUS[st][lang];
  stamp.className = "stamp " + (STATUS[st].cls === "go" ? "" : STATUS[st].cls === "stop" ? "stop" : "warn");

  renderTrap();
  renderChart(focusedPolicy);
  renderTornado(focusedPolicy);
  renderDetail(focusedAgent, focusedPolicy, target);
  renderAssumptions();
  document.getElementById("foot").textContent = t("foot");
}

function renderTrap() {
  const agent = PAYLOAD.agents.find(a => a.id === "health_blind");
  const naive = agent.naive.holdout;
  const rec = agent.selected.holdout;
  const increase = naive.hours / naive.baseline_hours - 1;
  const box = document.getElementById("trap");
  if (lang === "zh") {
    box.innerHTML = `<h2>${t("trapTitle")}</h2>
      <p>健康险盲区和稳妥的准确率同为 <strong>${pct(agent.accuracy)}</strong>。
      若按置信度最低的一档转人工，自动化率 <strong>${pct(naive.automation_rate)}</strong>，
      全成本人工 <strong>${hrs(naive.hours)}</strong>，全人工基线 <strong>${hrs(naive.baseline_hours)}</strong>
      （<strong>${increase >= 0 ? "+" : ""}${(increase * 100).toFixed(1)}%</strong>）。
      留出集下界 ${pct(naive.lcb)}。
      冻结后的策略是「${agent.selected.label}」，人工介入 ${pct(rec.human_touch_rate)}，工时 ${hrs(rec.hours)}。</p>`;
  } else {
    box.innerHTML = `<h2>${t("trapTitle")}</h2>
      <p>Health-blind matches Careful at <strong>${pct(agent.accuracy)}</strong> accuracy.
      The lowest-confidence slice automates <strong>${pct(naive.automation_rate)}</strong> and still takes
      <strong>${hrs(naive.hours)}</strong> against an all-human <strong>${hrs(naive.baseline_hours)}</strong>
      (<strong>${increase >= 0 ? "+" : ""}${(increase * 100).toFixed(1)}%</strong>).
      Holdout lower bound ${pct(naive.lcb)}.
      The frozen policy is “${agent.selected.label}”, with human touch ${pct(rec.human_touch_rate)} and ${hrs(rec.hours)}.</p>`;
  }
}

function renderChart(policy) {
  const panel = document.getElementById("chart-panel");
  panel.innerHTML = `<h2>${t("chart")}</h2>`;
  if (!policy) { panel.insertAdjacentHTML("beforeend", `<p>${t("noPolicy")}</p>`); return; }
  const curve = policy.curve;
  const w = 640, h = 280, pad = {l: 56, r: 12, t: 16, b: 36};
  const maxX = curve.volume[curve.volume.length - 1] || 1;
  const maxY = Math.max(...curve.agent, ...curve.human, 1) * 1.08;
  const X = v => pad.l + (v / maxX) * (w - pad.l - pad.r);
  const Y = v => h - pad.b - (v / maxY) * (h - pad.t - pad.b);
  const path = values => values.map((v, i) => `${i ? "L" : "M"}${X(curve.volume[i]).toFixed(1)},${Y(v).toFixed(1)}`).join(" ");
  let yTicks = "";
  for (let i = 0; i <= 4; i++) {
    const val = maxY * i / 4;
    yTicks += `<text class="axis" x="${pad.l - 8}" y="${Y(val) + 4}" text-anchor="end">${Math.round(val / 1000)}k</text>`;
    yTicks += `<line x1="${pad.l}" x2="${w - pad.r}" y1="${Y(val)}" y2="${Y(val)}" stroke="#eee6d8"/>`;
  }
  panel.insertAdjacentHTML("beforeend", `
    <svg viewBox="0 0 ${w} ${h}" role="img">
      ${yTicks}
      <path d="${path(curve.human)}" fill="none" stroke="#8a8175" stroke-width="2"/>
      <path d="${path(curve.agent)}" fill="none" stroke="#0e6b4a" stroke-width="2.5"/>
    </svg>
    <p class="note"><span style="color:#8a8175">― ${t("human")}</span> · <span style="color:#0e6b4a">― ${t("agent")}</span> · ${money(policy.holdout.baseline_dollars)} vs ${money(policy.holdout.dollars)} · breakeven ${policy.holdout.breakeven_cases == null ? "—" : Math.round(policy.holdout.breakeven_cases) + " cases"}</p>`);
}

function renderTornado(policy) {
  const panel = document.getElementById("tornado-panel");
  panel.innerHTML = `<h2>${t("tornado")}</h2>`;
  if (!policy) return;
  const rows = policy.tornado.slice(0, 7);
  const span = Math.max(...rows.map(r => Math.abs(r.low - r.base)), ...rows.map(r => Math.abs(r.high - r.base)), 1);
  const w = 360, rowH = 28, h = rows.length * rowH + 8;
  let body = "";
  rows.forEach((r, i) => {
    const y = 8 + i * rowH;
    const x0 = 150 + (Math.min(r.low, r.high) - r.base) / span * 90;
    const x1 = 150 + (Math.max(r.low, r.high) - r.base) / span * 90;
    body += `<text class="axis" x="4" y="${y + 12}">${r.label}</text>`;
    body += `<rect x="${x0}" y="${y}" width="${Math.max(2, x1 - x0)}" height="16" fill="#1f4d3a" opacity="0.8"/>`;
  });
  panel.insertAdjacentHTML("beforeend", `<svg viewBox="0 0 ${w} ${h}">${body}<line x1="150" x2="150" y1="0" y2="${h}" stroke="#1c1915"/></svg>`);
}

function renderDetail(agent, policy, target) {
  const panel = document.getElementById("detail");
  if (!policy) { panel.innerHTML = `<h2>${t("focus")}</h2><p>${t("noPolicy")}</p>`; return; }
  const h = policy.holdout;
  const cats = agent.calibration_categories.map(c => `<tr><td>${c.category}</td><td>${c.n}</td><td>${pct(c.accuracy)}</td></tr>`).join("");
  const a = h.assertions;
  const ah = Object.entries(policy.lcb_by_human_accuracy).map(([k, v]) => `${k}: ${pct(v)}`).join(" · ");
  panel.innerHTML = `<h2>${t("focus")} · ${agent.name}</h2>
    <p class="metric">${policy.label}</p>
    <p class="metric">n=${h.n}, successes=${h.successes}, point ${pct(h.reliability)}, CP ${pct(h.lcb)}, Wilson ${pct(h.wilson_lcb)}</p>
    <p class="metric">touch ${pct(h.human_touch_rate)} · automation ${pct(h.automation_rate)} · miss ${pct(h.miss_rate)} · a_h min ${h.a_h_min == null ? "none" : pct(h.a_h_min)}</p>
    <p class="metric">LCB by assumed reviewer accuracy — ${ah}</p>
    <h2>${t("categories")}</h2>
    <table><thead><tr><th>category</th><th>n</th><th>accuracy</th></tr></thead><tbody>${cats}</tbody></table>
    <h2>${t("assertions")}</h2>
    <p class="metric">${t("assertions")}: ${a.residual_violations}/${a.residual_n} (rate ${pct(a.residual_rate)}, one-sided upper ${pct(a.residual_upper)}). Agent-level ${a.agent_violations}/${a.agent_n}.</p>`;
}

function renderAssumptions() {
  const panel = document.getElementById("assumptions");
  panel.innerHTML = `<h2>${t("assumptions")}</h2><ul><li>${t("a1")}</li><li>${t("a2")}</li><li>${t("a3")}</li><li>${t("a4")}</li></ul>`;
}

document.getElementById("target").addEventListener("input", render);
document.getElementById("en").addEventListener("click", () => { lang = "en"; render(); });
document.getElementById("zh").addEventListener("click", () => { lang = "zh"; render(); });
render();
</script>
</body>
</html>
